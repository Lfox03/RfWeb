# Copier ce fichier en .env (jamais committé).
# Chargé par le serveur (server/src/index.ts) uniquement s'il est lancé depuis la racine du dépôt.
# Attention : le chemin de la base SQLite reste relatif au CWD (./attendance.db).

# Serveur HTTP (Express)
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# Serveur WebSocket (hub TypeScript server/src/websocket, transport standalone —
# le client, lui, passe toujours par /ws sur le port HTTP).
# À changer si 8080 est déjà occupé sur la machine (ex: llama.cpp local).
WS_PORT=8080

# Base SQLite (nouvelle couche server/src/db). Vide/absent = ./attendance.db
# (même fichier que le legacy), relatif au dossier de travail.
# DB_PATH=./attendance.db

# Authentification (Phase 3) — sessions serveur en mémoire + cookie HTTP-only.
# SESSION_TTL_HOURS=12      # durée de vie d'une session (heures)
# COOKIE_SECURE=1           # cookie « Secure » (HTTPS uniquement — à activer derrière TLS)
# COOKIE_NAME=sid           # nom du cookie de session

# Lecteur RFID : 1 = désactivé (mode hors ligne, aucun accès USB — utile hors
# atelier/CI). Par défaut le lecteur réel est utilisé.
# RFID_DISABLED=1

# Mot de passe du compte admin créé par npm run db:seed (développement seul).
# Défaut : « admin ». À changer sur toute installation réelle.
# SEED_ADMIN_PASSWORD=admin
